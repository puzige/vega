+    let retry = save_collapsed(&store, &[(SidebarCollapseTarget::Pinned, true)])?;
+    assert_eq!(retry.revision, before.revision + 1);
+    assert_eq!(retry.collapsed, vec![SidebarCollapseTarget::Pinned]);
