+fn pump_until(cx: &mut TestAppContext, mut done: impl FnMut(&App) -> bool) {
+    for _ in 0..1000 {
+        if cx.read(&mut done) {
+            return;
+        }
+        assert!(
+            cx.background_executor.tick(),
+            "expected production completion has no runnable work"
+        );
