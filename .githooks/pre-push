#!/bin/sh
# One scoped gate, bound to the exact clean commit being pushed.
repo=$(git rev-parse --show-toplevel) || exit 1
local_vars=$(git rev-parse --local-env-vars) || exit 1
for name in $local_vars; do
    case "$name" in
        GIT_*) unset "$name" ;;
        *) echo 'pre-push: unexpected Git environment name' >&2; exit 1 ;;
    esac
done
cd "$repo" || exit 1
exec python3 scripts/verify.py --pre-push
