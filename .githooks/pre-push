#!/bin/sh
# Vega pre-push hook — full quality gate (exec-guide §7).
# Install (once per clone): git config core.hooksPath .githooks
# Git passes the pushed ref list on stdin; it is deliberately not read.

# Homebrew's cargo shadows the rustup proxy in the default PATH; prepend the
# rustup bin dir so the toolchain pinned by rust-toolchain.toml is used.
PATH="$HOME/.cargo/bin:$PATH"
export PATH

# Git exports repository-local variables while invoking hooks. They must not
# leak into Cargo test fixtures because those fixtures own separate temporary
# repositories. Ask this Git version for the complete local-variable set, then
# fail closed unless every returned name is a Git variable we can safely unset.
git_local_env_vars=$(git rev-parse --local-env-vars) || {
    echo "[pre-push] FAILED: could not enumerate Git local environment variables."
    exit 1
}
for git_local_env_var in $git_local_env_vars; do
    case "$git_local_env_var" in
        GIT_*) unset "$git_local_env_var" ;;
        *)
            echo "[pre-push] FAILED: unexpected local environment variable name."
            exit 1
            ;;
    esac
done
unset git_local_env_var git_local_env_vars

echo "[pre-push] cargo clippy --all-targets -- -D warnings"
if ! cargo clippy --all-targets -- -D warnings; then
    echo ""
    echo "[pre-push] FAILED: clippy reported warnings."
    echo "Fix the warnings above, commit, then push again."
    echo "Emergency bypass (use sparingly): git push --no-verify"
    exit 1
fi

# All worktrees share one target/ directory, and cargo's own lock covers only
# the compile phase. Serialize the whole build+test span across worktrees so a
# concurrent run in a sibling worktree cannot reuse the wrong crate artifacts
# or make shared-state tests fail spuriously. --wait: a push gate should queue
# rather than fail just because another worktree is busy.
if [ -x scripts/cargo-lock.sh ]; then
    LOCK="scripts/cargo-lock.sh --wait"
else
    LOCK=""
fi

echo "[pre-push] cargo test --workspace"
if ! $LOCK cargo test --workspace; then
    echo ""
    echo "[pre-push] FAILED: tests failed."
    echo "Fix the failing tests above, commit, then push again."
    echo "Emergency bypass (use sparingly): git push --no-verify"
    exit 1
fi

echo "[pre-push] cargo build --workspace"
if ! $LOCK cargo build --workspace; then
    echo ""
    echo "[pre-push] FAILED: build failed."
    echo "Fix the build errors above, commit, then push again."
    echo "Emergency bypass (use sparingly): git push --no-verify"
    exit 1
fi

echo "[pre-push] OK: all gates passed"
exit 0
